# ============================================================================
# Copie este arquivo para .env.production e preencha com valores REAIS antes
# de subir em produção. NUNCA commite o .env.production de verdade no git.
# ============================================================================

# Domínio de verdade, sem "https://" (o Caddy adiciona sozinho)
DOMINIO=seu-dominio.com.br

# Gere uma senha forte de verdade — não use a de desenvolvimento.
# Sugestão pra gerar uma boa: openssl rand -base64 24
POSTGRES_USER=almoxaf
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_POR_UMA_FORTE
POSTGRES_DB=almoxaf
